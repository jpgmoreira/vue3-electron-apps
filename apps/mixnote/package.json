{
  "name": "mixnote",
  "productName": "Mixnote",
  "version": "0.0.1",
  "description": "Organize your notes and actively study them with flashcards",
  "main": "./out/main/main.js",
  "author": {
    "name": "The Mixnote Team",
    "email": "jpgmoreira19@gmail.com"
  },
  "homepage": "https://github.com/jpgmoreira/vue3-electron-apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpgmoreira/vue3-electron-apps.git"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "madge": "madge --circular --extensions ts src/main src/common src/preload",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "start": "electron-vite dev",
    "dev": "pnpm run start",
    "test": "vitest",
    "test:debug": "vitest --test-timeout=0 --no-file-parallelism",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/view": "^6.39.14",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lucide-vue-next": "^0.563.0",
    "md-editor-v3": "^6.3.1",
    "pinia": "^3.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^4.0.1",
    "happy-dom": "^20.0.10",
    "vite": "^7.1.6",
    "vue": "^3.5.21"
  }
}
