{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/**/*",
    "src/common/**/*",
    "src/preload/**/*",
    "tests/unit/renderer/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["./src/renderer/*"],
      "@common/*": ["./src/common/*"],
      "@preload/*": ["./src/preload/*"]
    }
  }
}
